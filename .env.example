# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change-me-in-production
NODE_ENV=development

# Google OAuth (never commit real credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Ethereal email (dev SMTP) — optional; auto-created if empty
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Email scheduling limits
EMAIL_MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
EMAIL_POLL_INTERVAL_MS=3000
EMAIL_POLL_BATCH_SIZE=5
EMAIL_JOB_ATTEMPTS=3

# Slack OAuth (optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/oauth/callback
SLACK_CHANNEL_ID=
