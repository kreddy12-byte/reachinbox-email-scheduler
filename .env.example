# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

# Redis (use REDIS_URL or REDIS_HOST + REDIS_PORT)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change-me-in-production
NODE_ENV=development

# Google OAuth (never commit real credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Ethereal email (dev SMTP) — never commit real credentials
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Email scheduling limits (defaults; per-email values override when provided)
EMAIL_MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
WORKER_CONCURRENCY=5
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=5000

# Slack OAuth (never commit real credentials)
# Bot scope used: chat:write
# Invite the ReachInbox bot into the target channel (e.g. #new-channel)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/oauth/callback
SLACK_CHANNEL_ID=
