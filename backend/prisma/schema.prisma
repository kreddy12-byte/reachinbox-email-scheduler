generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleId  String   @unique
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails          Email[]
  senders         Sender[]
  slackConnection SlackConnection?

  @@map("users")
}

model Sender {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  email        String
  displayName  String?
  etherealUser String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
  @@index([email])
  @@map("senders")
}

model Email {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  senderId     String      @db.Uuid
  recipient    String
  subject      String
  body         String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       EmailStatus @default(SCHEDULED)
  bullJobId    String?     @unique
  attempts     Int         @default(0)
  errorMessage String?
  sendDelayMs  Int         @default(2000)
  hourlyLimit  Int         @default(200)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipient])
  @@index([status])
  @@index([scheduledAt])
  @@index([userId])
  @@index([senderId])
  @@index([userId, status])
  @@map("emails")
}

model SlackConnection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  accessToken String
  teamId      String
  teamName    String?
  channelId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("slack_connections")
}
